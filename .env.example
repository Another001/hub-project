# Copy thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gate upload: client nhập đúng ACCESS_CODE -> nhận cookie token httpOnly.
# AUTH_SECRET: chuỗi random >=16 ký tự, tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_CODE=doi-ma-nay-di
AUTH_SECRET=thay-bang-chuoi-random-32-byte
AUTH_COOKIE_NAME=hub_auth
AUTH_MAX_AGE=2592000
MAX_UPLOAD_MB=4
UPLOAD_FOLDER=docs
